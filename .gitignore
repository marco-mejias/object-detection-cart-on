# =============================================================================
# .gitignore - Detección híbrida de productos en supermercado
# =============================================================================

# --- Datos (NUNCA subir a Git) ---
data/raw/**
data/processed/**
data/external/**
data/annotations/**
!data/raw/.gitkeep
!data/raw/*/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/annotations/.gitkeep

# --- Resultados pesados ---
results/dataset/**
results/models/**
results/logs/**
!results/dataset/.gitkeep
!results/models/.gitkeep
!results/logs/.gitkeep
!results/figures/.gitkeep

# --- Artefactos binarios ---
*.npy
*.pkl
*.joblib
*.pth
*.pt
*.h5

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# --- Entorno virtual ---
venv/
env/
ENV/
.venv/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Variables de entorno ---
.env
.env.local

# --- LaTeX (auxiliares) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# --- Documentos internos no compartidos ---
docs/protocolo_captura.md
